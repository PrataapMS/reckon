# Copy to .env and fill in. Never commit .env.
# Postgres connection string. Local Docker default shown; on Netlify use the Neon pooled URL.
DATABASE_URL=postgres://reckon:reckon@localhost:5432/reckon

# Session signing secret: 32+ random bytes, e.g. `openssl rand -base64 48`
SESSION_SECRET=change-me-to-a-long-random-string

# Passphrase hash produced by `pnpm --filter @reckon/api hash-passphrase "your passphrase"`
PASSPHRASE_HASH=

# Default location used until onboarding stores one (Bengaluru shown as an example).
DEFAULT_LAT=12.97
DEFAULT_LON=77.59
DEFAULT_TZ=Asia/Kolkata

# Contact address sent in the User-Agent to data providers (good API citizenship).
CONTACT_EMAIL=you@example.com

# Telegram (optional; the PWA works without it). Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
# The bot's username without the @, used for t.me/<bot>?start=<token> links.
TELEGRAM_BOT_USERNAME=
# 16–256 characters of A–Z a–z 0–9 _ -, e.g. `openssl rand -hex 24`. Used in the webhook path and header.
TELEGRAM_WEBHOOK_SECRET=

# Public site URL for "Open in Reckon" buttons (Netlify sets URL automatically; must be https).
APP_URL=

# Raw evidence storage: netlify (Blobs, automatic on Netlify) | fs (local files) | memory.
EVIDENCE_STORE=fs
EVIDENCE_DIR=.data/evidence

# Optional: a GitHub token with no scopes lifts the 60 requests/hour limit for release checks.
GITHUB_TOKEN=

# Web Push (optional; the fallback when Telegram is not linked). Generate with `pnpm push:keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services; defaults to mailto:CONTACT_EMAIL.
VAPID_SUBJECT=
